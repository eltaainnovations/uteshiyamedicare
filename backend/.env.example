# Duplicate as backend/.env for local development.

# Used to sign session JWTs. Generate a real random value before any
# non-local deployment (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
JWT_SECRET=dev-only-secret-change-me

# Rolling inactivity window enforced server-side (see PROJECT_CONTEXT.md).
SESSION_TIMEOUT_MINUTES=10

# When true, /auth/login echoes the 2FA code back in the response (dev_otp)
# and logs it, instead of emailing it — there's no SMTP integration yet.
DEMO_MODE=true

CORS_ORIGINS=["http://localhost:5173"]

# ERPNext instance the Portal authenticates against (cookie-based
# /api/method/login + /api/method/logout only).
ERPNEXT_BASE_URL=https://test.uteshiyamedicare.com

# How long (minutes) the encrypted ERPNext sid is kept server-side. Set
# this to match your ERPNext instance's "session_expiry" system setting.
ERPNEXT_SID_TTL_MINUTES=480

# Encrypts the ERPNext sid at rest in the server-side session store.
# Optional for local dev (a random key is generated per process start if
# unset). Generate one before any persistent/shared deployment:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SID_ENCRYPTION_KEY=
